{
  "manifest_version": 3,
  "name": "QR Code Generator",
  "version": "1.1.0",
  "description": "Generate QR codes for any webpage with floating website logo and overlay display",
  
  "permissions": [
    "activeTab",
    "tabs"
  ],
  
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  
  "action": {
    "default_title": "QR Code Generator - Click floating logo on page to generate QR code"
  },
  
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  
  "background": {
    "service_worker": "background.js"
  },
  
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "chrome://*/*",
        "chrome-extension://*/*",
        "moz-extension://*/*",
        "about:*/*",
        "file://*/*"
      ],
      "js": ["qrcode.min.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  
  "web_accessible_resources": [
    {
      "resources": ["icons/*.png", "qrcode.min.js"],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
} 